{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/features/blog/tooling/cli.ts",
    // Loaded by path string from the Next MDX adapter / processor loader.
    "src/features/blog/rendering/code/code.ts",
    "src/features/blog/rendering/contract.ts",
  ],
  // Vite+ requires the vite override/catalog pin; mprocs and MDX peers are
  // intentional but not import-visible the way fallow models JS deps.
  "ignoreDependencies": [
    "@mdx-js/loader",
    "@mdx-js/react",
    "@next/mdx",
    "@tanstack/react-devtools",
    "@tanstack/react-hotkeys-devtools",
    "babel-plugin-react-compiler",
    "mprocs",
    "react-dom",
    "shadcn",
    "tailwindcss",
    "typescript",
  ],
  "ignoreDependencyOverrides": [
    {
      "package": "vite",
      "source": "pnpm-workspace.yaml",
    },
  ],
  "ignoreExportsUsedInFile": true,
  // Vendored shadcn/ui surface — unused named exports are intentional API.
  "ignoreExports": [
    {
      "file": "src/shared/ui/**/*.{ts,tsx}",
      "exports": ["*"],
    },
    {
      // `[slug]` must be escaped so the glob does not treat it as a char class.
      "file": "src/app/blog/[[]slug]/**/route.ts",
      "exports": ["generateStaticParams"],
    },
  ],
  "rules": {
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependencies": "warn",
  },
  "boundaries": {
    "zones": [
      {
        "name": "app",
        "patterns": [
          "src/app/**",
          "src/mdx-components.tsx",
          "src/mdx.d.ts",
          "e2e/**",
          "next.config.ts",
          "playwright.config.ts",
          "vite.config.ts",
        ],
      },
      {
        "name": "features/blog",
        "patterns": ["src/features/blog/**"],
      },
      {
        "name": "features/portfolio",
        "patterns": ["src/features/portfolio/**"],
      },
      {
        "name": "shared",
        "patterns": ["src/shared/**"],
      },
    ],
    "rules": [
      {
        "from": "app",
        "allow": ["features/blog", "features/portfolio", "shared"],
      },
      { "from": "features/blog", "allow": ["shared"] },
      { "from": "features/portfolio", "allow": ["shared"] },
      { "from": "shared", "allow": [] },
    ],
    "coverage": {
      "requireAllFiles": true,
    },
  },
}
